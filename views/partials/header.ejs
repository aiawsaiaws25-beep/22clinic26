<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= clinic.name %> in <%= clinic.area %>. General physician, ENT, dental and cardiology care, close to home.">
  <meta name="theme-color" content="#125bd6">
  <title><%= clinic.name %> | <%= clinic.area %></title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/site.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="top-bar">
    <div class="container d-flex flex-wrap justify-content-between gap-2">
      <span><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>Your neighborhood clinic in <%= clinic.area %></span>
      <span><i class="bi bi-clock me-2" aria-hidden="true"></i><%= clinic.hours %></span>
    </div>
  </div>
  <header class="site-header">
    <nav class="navbar navbar-expand-lg py-3" aria-label="Main navigation">
      <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/#home" aria-label="<%= clinic.name %> home">
          <span class="brand-icon"><i class="bi bi-heart-pulse-fill" aria-hidden="true"></i></span>
          <span class="brand-text">Lakeside<span>MEDICAL CLINIC</span></span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="main-nav">
          <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-4">
            <li class="nav-item"><a class="nav-link" href="/#home">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="/#specialties">Specialties</a></li>
            <li class="nav-item"><a class="nav-link" href="/#about">About</a></li>
            <li class="nav-item"><a class="nav-link" href="/#contact">Contact</a></li>
            <li class="nav-item"><a class="btn btn-primary nav-book" href="/book">Book an appointment <i class="bi bi-arrow-up-right ms-2" aria-hidden="true"></i></a></li>
          </ul>
        </div>
      </div>
    </nav>
  </header>
